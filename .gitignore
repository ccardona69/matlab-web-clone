# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Logs & capture artifacts
*.log
*.err

# REA evidence bundles (large JSONs >100MB) and recovered third-party sources
/rea/*.json
/rea/ui-analysis/*.json
# Exception: small metadata digests (no MathWorks code, only inventories/hashes)
!/rea/ui-analysis/ui-components-digest.json
!/rea/ui-analysis/ui-components-details.json
/rea/reconstructed/
/rea/recovered-src/

# MATLAB installation assets: PROHIBIDO en el repo (solo runtime via MATLAB_ROOT,
# ver docs/OWNERSHIP.md regla 3 y backend/local_assets.py). Guard por extension:
*.woff
*.woff2
*.ttf
*.otf
*.eot
# Guard por carpeta (copias locales accidentales):
/local-assets/
/frontend/matlab-assets/
/vendor/matlab/
